<?xml version="1.0" encoding="UTF-8"?>

<!--
    Configuration des tests automatises CESIZen.

    Les suites correspondent aux trois niveaux exiges par le cahier des
    charges. L'ensemble constitue la suite de non-regression, rejouee
    integralement avant chaque fusion et chaque livraison : l'echec d'un
    seul test entraine le refus de livraison.

    Executer une suite ciblee avec l option testsuite de PHPUnit,
    par exemple la suite nommee "unitaires".
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         convertDeprecationsToExceptions="false"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="SYMFONY_PHPUNIT_REMOVE" value="" />
        <server name="SYMFONY_PHPUNIT_VERSION" value="9.5" />
    </php>

    <testsuites>
        <!-- Composants isoles : aucune base de donnees, execution immediate. -->
        <testsuite name="unitaires">
            <directory>tests/Unit</directory>
        </testsuite>

        <!-- Parcours complets a travers le noyau HTTP et la base de donnees. -->
        <testsuite name="fonctionnels">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory>src/DataFixtures</directory>
            <file>src/Kernel.php</file>
        </exclude>
    </coverage>

    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener" />
    </listeners>

    <extensions>
    </extensions>
</phpunit>
