# Fichier de VALEURS PAR DÉFAUT, versionné.
# Ordre de chargement (le dernier gagne) :
#   .env  <  .env.$APP_ENV  <  .env.local  <  .env.$APP_ENV.local  <  variables d'environnement réelles
#
# AUCUN SECRET RÉEL NE DOIT FIGURER ICI : ce fichier est public dans le dépôt Git.
# Les secrets locaux vont dans .env.local (ignoré par Git).
# Les secrets de production sont injectés par variables d'environnement / Symfony Vault.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
# Valeur factice : surchargée par .env.local en dev et par la variable d'env en prod.
APP_SECRET=CHANGE_ME_IN_ENV_LOCAL
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Base MySQL 8 : le conteneur "database" en Docker, 127.0.0.1 en installation locale AMPPS.
DATABASE_URL="mysql://cesizen:CHANGE_ME_IN_ENV_LOCAL@database:3306/cesizen?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
