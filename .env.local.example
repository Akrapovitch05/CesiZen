# Gabarit de .env.local — à copier puis renseigner : cp .env.local.example .env.local
# .env.local n'est JAMAIS versionné : il porte les secrets réels du poste.

# Clé de signature Symfony (sessions, CSRF, remember-me).
# Générer une valeur unique : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=

# Connexion utilisée par Symfony hors Docker (installation locale AMPPS).
# En Docker, DATABASE_URL est injectée par compose.yaml et prime sur cette valeur.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/cesizen?serverVersion=8.0.32&charset=utf8mb4"

# --- Variables lues par Docker Compose ---
MYSQL_DATABASE=cesizen
MYSQL_USER=cesizen
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
